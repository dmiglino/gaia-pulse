# GaiaPulse Environment Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
DATABASE_URL=postgresql://gaiapulse:gaiapulse@localhost:5432/gaiapulse
# For Docker: DATABASE_URL=postgresql://gaiapulse:gaiapulse@db:5432/gaiapulse

# Authentication
# Session cookie settings
SESSION_COOKIE_NAME=gaiapulse_session
SESSION_MAX_AGE_SECONDS=604800  # 7 days

# NLP / AI (optional — app works without these, uses rule-based fallback)
# Compatible with OpenAI API or any OpenAI-compatible endpoint
OPENAI_API_KEY=gpt-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text (optional — enables voice input)
# Uses OpenAI Whisper API when key is provided
STT_PROVIDER=whisper  # whisper | none
STT_API_KEY=  # defaults to OPENAI_API_KEY if empty

# Background jobs
# The four jobs run at fixed local times (see app/jobs/scheduler.py), not every N
# minutes, so the hour no longer depends on when the process started.
# Removed: NOTIFICATION_JOB_INTERVAL_MINUTES and SUGGESTION_JOB_INTERVAL_MINUTES.
# Unknown keys are ignored, so an old .env still boots — delete them by hand.
ENABLE_BACKGROUND_JOBS=true
# No-notification window, in whole local hours (0-23). It wraps midnight when the
# start is greater than the end; equal values mean no quiet hours at all. The three
# notification jobs skip their run inside it; suggestion generation is unaffected.
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# Localization — also sets job run times, quiet hours, and every "today" the UI shows
TIMEZONE=America/Argentina/Buenos_Aires
