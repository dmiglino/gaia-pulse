# GaiaPulse Environment Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
DATABASE_URL=postgresql://gaiapulse:gaiapulse@localhost:5432/gaiapulse
# For Docker: DATABASE_URL=postgresql://gaiapulse:gaiapulse@db:5432/gaiapulse

# Authentication
# Session cookie settings
SESSION_COOKIE_NAME=gaiapulse_session
SESSION_MAX_AGE_SECONDS=604800  # 7 days

# NLP / AI (optional — app works without these, uses rule-based fallback)
# Compatible with OpenAI API or any OpenAI-compatible endpoint
OPENAI_API_KEY=gpt-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text (optional — enables voice input)
# Uses OpenAI Whisper API when key is provided
STT_PROVIDER=whisper  # whisper | none
STT_API_KEY=  # defaults to OPENAI_API_KEY if empty

# Background jobs
ENABLE_BACKGROUND_JOBS=true
NOTIFICATION_JOB_INTERVAL_MINUTES=60
SUGGESTION_JOB_INTERVAL_MINUTES=360

# Frontend
TIMEZONE=America/Argentina/Buenos_Aires
