msgid "That percentage is how sure I am that I read your sentence right — not whether the numbers are correct. Have a look before saving."
msgstr "Ese porcentaje es qué tan seguro estoy de haber entendido tu frase — no de que los números estén bien. Mirá antes de guardar."

msgid "Understood clearly"
msgstr "Se entendió bien"

msgid "Mostly understood"
msgstr "Se entendió casi todo"

msgid "Worth checking"
msgstr "Conviene revisarlo"

msgid "Read from the wording"
msgstr "Leído de las palabras"

msgid "Read by the assistant"
msgstr "Leído por el asistente"

msgid "Wording plus assistant"
msgstr "Palabras más asistente"

msgid "Heard:"
msgstr "Escuché:"

msgid "For"
msgstr "Para"

msgid "Shared pantry"
msgstr "Despensa compartida"

msgid "body fat"
msgstr "de grasa corporal"

msgid "cm waist"
msgstr "cm de cintura"

