# ── Captura en lenguaje natural (v3, fase 3) ──
# La pantalla del flujo central y su preview de confirmación. Los textos del JS del
# componente entran acá porque pasan por `_('…') | tojson`, que sí es extraíble.

msgid "Tell me what happened in your own words — I work out the rest."
msgstr "Contame qué pasó con tus palabras — del resto me encargo yo."

msgid "What happened?"
msgstr "¿Qué pasó?"

msgid "Name %(names)s and I will work out who did what."
msgstr "Nombrá a %(names)s y yo deduzco quién hizo qué."

msgid "e.g. we had pasta for dinner · I ran for 30 min · bought 1 kg of oats"
msgstr "ej. cenamos fideos · corrí 30 min · compré 1 kg de avena"

msgid "Or start from one of these"
msgstr "O arrancá por una de estas"

msgid "or say it out loud"
msgstr "o decilo en voz alta"

msgid "Record a voice note"
msgstr "Grabar una nota de voz"

msgid "Tap the mic to start."
msgstr "Tocá el micrófono para empezar."

msgid "Tap again to stop."
msgstr "Tocá de nuevo para parar."

msgid "Reading what you wrote…"
msgstr "Leyendo lo que escribiste…"

msgid "I could not read that. Try again, or shorten it and write it in the box."
msgstr "No pude leer eso. Probá de nuevo, o acortalo y escribilo en el cuadro."

msgid "Review before saving"
msgstr "Revisar antes de guardar"

msgid "Reading…"
msgstr "Leyendo…"

msgid "Voice note ready"
msgstr "Nota de voz lista"

msgid "I could not reach the microphone. Allow access and try again."
msgstr "No pude acceder al micrófono. Permití el acceso y probá de nuevo."

